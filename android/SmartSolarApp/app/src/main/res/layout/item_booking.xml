<?xml version="1.0" encoding="utf-8"?>
<!--
    Smart Solar Microgrid Trading System
    Booking List Item Layout
    Member 2 - Native Android Prosumer Application
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/Widget.SmartSolar.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="6dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardElevation="2dp"
    app:cardCornerRadius="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Row: Node Name + Status Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tvItemNodeName"
                style="@style/TextAppearance.SmartSolar.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="Colombo North Grid Hub" />

            <TextView
                android:id="@+id/tvItemStatusBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/card_background"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:textColor="@color/status_pending"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="Pending" />
        </LinearLayout>

        <!-- Booking ID & Energy Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="6dp">

            <TextView
                android:id="@+id/tvItemBookingId"
                style="@style/TextAppearance.SmartSolar.Caption"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="@color/on_surface_secondary"
                tools:text="ID: BK-2026-0926-001" />

            <TextView
                android:id="@+id/tvItemEnergy"
                style="@style/TextAppearance.SmartSolar.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="⚡ 50.0 kWh" />
        </LinearLayout>

        <!-- Date and Time Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <TextView
                android:id="@+id/tvItemDateTime"
                style="@style/TextAppearance.SmartSolar.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="6dp"
                android:textColor="@color/on_surface"
                android:textSize="13sp"
                tools:text="📅 28 Sep 2026 • 10:00 AM - 12:00 PM" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:id="@+id/itemDivider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height"
            android:layout_marginBottom="8dp"
            android:background="@color/divider" />

        <!-- Actions Row -->
        <LinearLayout
            android:id="@+id/layoutItemActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <!-- Edit Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemEdit"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:text="@string/action_update"
                android:textColor="@color/primary"
                android:textSize="12sp" />

            <!-- Cancel Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemCancel"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp"
                android:minHeight="0dp"
                android:paddingHorizontal="10dp"
                android:paddingVertical="0dp"
                android:text="@string/action_cancel"
                android:textColor="@color/status_error"
                android:textSize="12sp" />

            <!-- View QR Code Action Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnItemQr"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:minHeight="0dp"
                android:paddingHorizontal="12dp"
                android:paddingVertical="0dp"
                android:text="QR Code"
                android:textColor="@color/primary_dark"
                android:textSize="12sp"
                app:strokeColor="@color/primary"
                app:strokeWidth="1dp" />

        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

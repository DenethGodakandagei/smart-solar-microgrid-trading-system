<?xml version="1.0" encoding="utf-8"?>
<!--
    Smart Solar Microgrid Trading System
    QR Generator Screen Layout
    Member 2 - Native Android Prosumer Application
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/screen_padding_horizontal"
        android:paddingVertical="@dimen/screen_padding_vertical">

        <!-- Header Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/tvQrTitle"
                style="@style/TextAppearance.SmartSolar.Headline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/qr_generate_title" />

            <TextView
                style="@style/TextAppearance.SmartSolar.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center"
                android:text="@string/qr_instruction" />
        </LinearLayout>

        <!-- QR Code Display Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartSolar.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardElevation="4dp"
            app:cardCornerRadius="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Frame for QR Image & Loading -->
                <FrameLayout
                    android:layout_width="260dp"
                    android:layout_height="260dp"
                    android:background="@color/white"
                    android:padding="8dp">

                    <ImageView
                        android:id="@+id/ivQrCode"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="@string/cd_qr_code"
                        android:scaleType="fitCenter" />

                    <ProgressBar
                        android:id="@+id/pbQrLoading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:indeterminateTint="@color/primary"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Security Verification Note -->
                <TextView
                    android:id="@+id/tvSecurityNote"
                    style="@style/TextAppearance.SmartSolar.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="🔒 Encrypted • Valid for single transaction"
                    android:textColor="@color/secondary_dark"
                    android:textStyle="bold" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Booking Details Card -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.SmartSolar.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardElevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <!-- Booking ID + Status -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:id="@+id/tvQrBookingId"
                        style="@style/TextAppearance.SmartSolar.Body"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textColor="@color/primary_dark"
                        android:textStyle="bold"
                        tools:text="ID: BK-2026-0926-001" />

                    <TextView
                        android:id="@+id/tvQrStatusBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/card_background"
                        android:paddingHorizontal="@dimen/badge_padding_horizontal"
                        android:paddingVertical="@dimen/badge_padding_vertical"
                        android:textColor="@color/status_success"
                        android:textSize="@dimen/text_caption"
                        android:textStyle="bold"
                        tools:text="Approved" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/divider_height"
                    android:layout_marginBottom="10dp"
                    android:background="@color/divider" />

                <!-- Node -->
                <TextView
                    style="@style/TextAppearance.SmartSolar.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/booking_label_node" />

                <TextView
                    android:id="@+id/tvQrNodeName"
                    style="@style/TextAppearance.SmartSolar.Body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    tools:text="Colombo North Grid Hub" />

                <!-- Date, Time, Energy -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.SmartSolar.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/booking_label_time_slot" />

                        <TextView
                            android:id="@+id/tvQrDateTime"
                            style="@style/TextAppearance.SmartSolar.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="28 Sep • 10:00 AM" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/TextAppearance.SmartSolar.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/booking_label_energy_kwh" />

                        <TextView
                            android:id="@+id/tvQrEnergy"
                            style="@style/TextAppearance.SmartSolar.Body"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/primary"
                            android:textStyle="bold"
                            tools:text="50.0 kWh" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Action Buttons Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnQrDone"
                style="@style/Widget.SmartSolar.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/btn_height"
                android:text="@string/booking_btn_done"
                android:textAllCaps="false"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>

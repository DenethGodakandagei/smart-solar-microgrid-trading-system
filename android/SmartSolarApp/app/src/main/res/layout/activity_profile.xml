<?xml version="1.0" encoding="utf-8"?>
<!--
    Smart Solar Microgrid Trading System
    Profile Screen Layout
    Member 2 - Native Android Prosumer Application
-->
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipeRefreshLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/screen_padding_horizontal"
            android:paddingVertical="@dimen/screen_padding_vertical">

            <!-- Avatar & Header Section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="16dp"
                android:paddingBottom="16dp">

                <!-- Avatar Circle Container -->
                <FrameLayout
                    android:layout_width="@dimen/avatar_size"
                    android:layout_height="@dimen/avatar_size"
                    android:background="@drawable/gradient_header"
                    android:elevation="4dp">

                    <TextView
                        android:id="@+id/tvAvatarInitials"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:textColor="@color/white"
                        android:textSize="28sp"
                        android:textStyle="bold"
                        tools:text="JD" />
                </FrameLayout>

                <!-- Full Name -->
                <TextView
                    android:id="@+id/tvProfileName"
                    style="@style/TextAppearance.SmartSolar.Headline"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    tools:text="John Doe" />

                <!-- NIC -->
                <TextView
                    android:id="@+id/tvProfileNic"
                    style="@style/TextAppearance.SmartSolar.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/primary_dark"
                    android:textStyle="bold"
                    tools:text="NIC: 199123456789" />

                <!-- Status Badge -->
                <TextView
                    android:id="@+id/tvProfileStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/card_background"
                    android:paddingHorizontal="@dimen/badge_padding_horizontal"
                    android:paddingVertical="@dimen/badge_padding_vertical"
                    android:textColor="@color/status_success"
                    android:textSize="@dimen/text_caption"
                    android:textStyle="bold"
                    tools:text="Active" />
            </LinearLayout>

            <!-- Loading Indicator -->
            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="8dp"
                android:indeterminateTint="@color/primary"
                android:visibility="gone" />

            <!-- Profile Details Card -->
            <com.google.android.material.card.MaterialCardView
                style="@style/Widget.SmartSolar.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardElevation="@dimen/card_elevation">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/card_padding">

                    <TextView
                        style="@style/TextAppearance.SmartSolar.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:text="@string/profile_title" />

                    <!-- Email Field -->
                    <TextView
                        style="@style/TextAppearance.SmartSolar.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_label_email" />

                    <TextView
                        android:id="@+id/tvProfileEmail"
                        style="@style/TextAppearance.SmartSolar.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        tools:text="john.doe@example.com" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:layout_marginBottom="12dp"
                        android:background="@color/divider" />

                    <!-- Phone Field -->
                    <TextView
                        style="@style/TextAppearance.SmartSolar.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_label_phone" />

                    <TextView
                        android:id="@+id/tvProfilePhone"
                        style="@style/TextAppearance.SmartSolar.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        tools:text="+94 77 123 4567" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:layout_marginBottom="12dp"
                        android:background="@color/divider" />

                    <!-- Address Field -->
                    <TextView
                        style="@style/TextAppearance.SmartSolar.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_label_address" />

                    <TextView
                        android:id="@+id/tvProfileAddress"
                        style="@style/TextAppearance.SmartSolar.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        tools:text="123 Solar Way, Colombo 03" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/divider_height"
                        android:layout_marginBottom="12dp"
                        android:background="@color/divider" />

                    <!-- Member Since -->
                    <TextView
                        style="@style/TextAppearance.SmartSolar.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/profile_label_member_since" />

                    <TextView
                        android:id="@+id/tvProfileMemberSince"
                        style="@style/TextAppearance.SmartSolar.Body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        tools:text="15 Aug 2026" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Edit Profile Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditProfile"
                    style="@style/Widget.SmartSolar.Button.Primary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginBottom="12dp"
                    android:text="@string/profile_btn_edit" />

                <!-- Deactivate Account Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDeactivateAccount"
                    style="@style/Widget.SmartSolar.Button.Danger"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height"
                    android:layout_marginBottom="12dp"
                    android:text="@string/profile_btn_deactivate" />

                <!-- Logout Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/Widget.SmartSolar.Button.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/btn_height"
                    android:text="@string/action_logout" />

            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

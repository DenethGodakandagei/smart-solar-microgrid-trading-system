<?xml version="1.0" encoding="utf-8"?>
<!--
    Smart Solar Microgrid Trading System
    Prosumer Dashboard Layout
    Member 2 - Native Android Prosumer Application
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Main Scrollable Dashboard Content -->
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshDashboard"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:fillViewport="true">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="24dp">

                    <!-- Header Gradient Hero Card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/gradient_header"
                        android:orientation="vertical"
                        android:paddingHorizontal="20dp"
                        android:paddingTop="28dp"
                        android:paddingBottom="24dp"
                        android:elevation="4dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvGreeting"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:textColor="@color/white"
                                    android:textSize="22sp"
                                    android:textStyle="bold"
                                    tools:text="Hello, John Doe" />

                                <TextView
                                    android:id="@+id/tvUserNic"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:textColor="#E0FFFFFF"
                                    android:textSize="13sp"
                                    tools:text="NIC: 199123456789 • Solar Prosumer" />
                            </LinearLayout>

                            <!-- Profile Shortcut Button -->
                            <ImageButton
                                android:id="@+id/btnHeaderProfile"
                                android:layout_width="44dp"
                                android:layout_height="44dp"
                                android:background="@drawable/card_background"
                                android:contentDescription="@string/profile_title"
                                android:src="@android:drawable/ic_menu_myplaces"
                                app:tint="@color/primary_dark" />

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Statistics Cards Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="16dp">

                        <TextView
                            style="@style/TextAppearance.SmartSolar.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="10dp"
                            android:text="Energy Reservations Overview" />

                        <!-- Stats Cards 2-Column Row -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <!-- Pending Reservations Card -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardPendingStats"
                                style="@style/Widget.SmartSolar.Card.Stat"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="@color/status_pending_light"
                                app:strokeColor="@color/status_pending"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="⏳"
                                        android:textSize="20sp" />

                                    <TextView
                                        android:id="@+id/tvPendingCount"
                                        style="@style/TextAppearance.SmartSolar.StatNumber"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:textColor="@color/status_pending"
                                        android:textSize="28sp"
                                        tools:text="3" />

                                    <TextView
                                        style="@style/TextAppearance.SmartSolar.Caption"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/dashboard_pending_count"
                                        android:textColor="@color/on_surface"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <!-- Approved Bookings Card -->
                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/cardApprovedStats"
                                style="@style/Widget.SmartSolar.Card.Stat"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:clickable="true"
                                android:focusable="true"
                                app:cardBackgroundColor="@color/status_success_light"
                                app:strokeColor="@color/status_success"
                                app:strokeWidth="1dp">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:padding="12dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="✅"
                                        android:textSize="20sp" />

                                    <TextView
                                        android:id="@+id/tvApprovedCount"
                                        style="@style/TextAppearance.SmartSolar.StatNumber"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="4dp"
                                        android:textColor="@color/status_success"
                                        android:textSize="28sp"
                                        tools:text="5" />

                                    <TextView
                                        style="@style/TextAppearance.SmartSolar.Caption"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="@string/dashboard_approved_count"
                                        android:textColor="@color/on_surface"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>
                    </LinearLayout>

                    <!-- Quick Actions Grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="16dp"
                        android:paddingTop="20dp">

                        <TextView
                            style="@style/TextAppearance.SmartSolar.Title"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="@string/dashboard_quick_actions" />

                        <!-- Row 1: New Booking + My Bookings -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:layout_marginBottom="10dp">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnQuickNewBooking"
                                style="@style/Widget.SmartSolar.Card"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:clickable="true"
                                android:focusable="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="14dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="➕"
                                        android:textSize="24sp" />

                                    <TextView
                                        style="@style/TextAppearance.SmartSolar.Body"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:text="@string/dashboard_action_new_booking"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnQuickMyBookings"
                                style="@style/Widget.SmartSolar.Card"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:clickable="true"
                                android:focusable="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="14dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="📅"
                                        android:textSize="24sp" />

                                    <TextView
                                        style="@style/TextAppearance.SmartSolar.Body"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:text="@string/dashboard_action_my_bookings"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                        <!-- Row 2: History + Nearby Nodes -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnQuickHistory"
                                style="@style/Widget.SmartSolar.Card"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:clickable="true"
                                android:focusable="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="14dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="📜"
                                        android:textSize="24sp" />

                                    <TextView
                                        style="@style/TextAppearance.SmartSolar.Body"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:text="History"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                            <com.google.android.material.card.MaterialCardView
                                android:id="@+id/btnQuickNearbyNodes"
                                style="@style/Widget.SmartSolar.Card"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginStart="6dp"
                                android:clickable="true"
                                android:focusable="true">

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="vertical"
                                    android:padding="14dp">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="📍"
                                        android:textSize="24sp" />

                                    <TextView
                                        style="@style/TextAppearance.SmartSolar.Body"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginTop="6dp"
                                        android:text="@string/dashboard_action_nearby_nodes"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </com.google.android.material.card.MaterialCardView>

                        </LinearLayout>

                    </LinearLayout>

                    <!-- Recent Bookings Section -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingTop="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingHorizontal="16dp"
                            android:layout_marginBottom="6dp">

                            <TextView
                                style="@style/TextAppearance.SmartSolar.Title"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/dashboard_recent_bookings" />

                            <TextView
                                android:id="@+id/tvViewAllBookings"
                                style="@style/TextAppearance.SmartSolar.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/primary"
                                android:textStyle="bold"
                                android:text="@string/action_view_all" />
                        </LinearLayout>

                        <!-- Recent Bookings List -->
                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rvRecentBookings"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:clipToPadding="false"
                            android:nestedScrollingEnabled="false"
                            tools:itemCount="2"
                            tools:listitem="@layout/item_booking" />

                        <!-- Recent Empty Banner -->
                        <LinearLayout
                            android:id="@+id/layoutRecentEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="24dp"
                            android:visibility="gone"
                            tools:visibility="visible">

                            <TextView
                                style="@style/TextAppearance.SmartSolar.Caption"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="No recent bookings found." />
                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

        <!-- Bottom Navigation Bar -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigation"
            style="@style/Widget.SmartSolar.BottomNav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:menu="@menu/bottom_nav_prosumer" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

<?xml version="1.0" encoding="utf-8"?>
<!--
    Smart Solar Microgrid Trading System
    QR Scanner Screen Layout
    Member 2 - Native Android Prosumer Application
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!-- ZXing Camera Viewfinder -->
    <com.journeyapps.barcodescanner.DecoratedBarcodeView
        android:id="@+id/barcodeScannerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Top Overlay Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="#99000000"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="24dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnScannerBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/cd_back_button"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvScannerTitle"
                style="@style/TextAppearance.SmartSolar.Headline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/qr_scan_title"
                android:textColor="@color/white"
                android:textSize="20sp" />

            <!-- Flashlight Toggle Button -->
            <ImageButton
                android:id="@+id/btnToggleFlash"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Toggle Flashlight"
                android:src="@android:drawable/ic_menu_camera"
                app:tint="@color/white" />
        </LinearLayout>

        <TextView
            style="@style/TextAppearance.SmartSolar.Caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/qr_scan_instruction"
            android:textColor="#CCFFFFFF" />
    </LinearLayout>

    <!-- Bottom Controls & Manual Entry Fallback -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="#CC000000"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="24dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManualEntry"
            style="@style/Widget.SmartSolar.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="@dimen/btn_height"
            android:text="Enter Booking ID Manually"
            android:textColor="@color/white"
            app:strokeColor="@color/white" />

    </LinearLayout>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/pbScanning"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/primary"
        android:visibility="gone" />

</FrameLayout>
